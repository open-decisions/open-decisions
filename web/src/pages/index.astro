---
import Base from "../layouts/Base.astro";
import HouseholdMeasures from "../components/islands/HouseholdMeasures.svelte";
import { edition, url, showDrafts } from "../lib/edition";
import { getBills, getCards, getHouseholds, meta } from "../lib/data";

const cards = await getCards();
const households = await getHouseholds();
const bills = await getBills();
const measures = cards.map((c) => ({
  id: c.id,
  title: c.title,
  status: `${c.status_parts.state} · ${c.status_parts.bill_title}`,
  year: c.years.short,
  href: url(`massnahmen/${c.id}/`),
  values: Object.fromEntries(c.households.map((h) => [h.id, { value: h.short.value, label: h.short.label, tone: h.short.tone }])),
}));
const tiles = [
  { n: meta.stage_counts.introduced, label: "neu eingebracht" },
  { n: meta.stage_counts.committee, label: "im Ausschuss" },
  { n: meta.stage_counts.passed_first_chamber, label: `im ${edition.chambers.first} beschlossen` },
  { n: meta.stage_counts.passed_second_chamber, label: `${edition.chambers.second} durch` },
  { n: meta.stage_counts.published, label: "gelten" },
];
const recent = bills.filter((b) => b.stage === "introduced" || b.stage === "committee").slice(0, 3);
const hasDrafts = cards.some((c) => !c.approved);
---
<Base title="Startseite" current="measures" draftBanner={showDrafts && hasDrafts}>
  <section class="container hero">
    <h1>{edition.tagline}</h1>
    <p class="muted">{edition.intro}</p>
  </section>

  <section id="karten" class="container cards">
    {measures.length > 0
      ? <HouseholdMeasures client:load households={households} measures={measures} />
      : <p class="box">Noch keine freigegebenen Karten. Die ersten Maßnahmen werden gerade geprüft.</p>}
  </section>

  {edition.features.tracker && (
    <section class="band">
      <div class="container">
        <div class="band-head">
          <h2>Was der {edition.chambers.first} gerade berät</h2>
          <a href={url("gesetze/")}>Alle {meta.bill_count} Gesetzesvorhaben</a>
        </div>
        <p class="muted">{edition.legislative_period}. Daten: {edition.data_source}, Stand {meta.data_as_of_text}.</p>
        <div class="tiles">
          {tiles.map((t) => <div class="tile"><div class="num">{t.n}</div><div class="muted">{t.label}</div></div>)}
        </div>
        <h3>Zuletzt eingebracht</h3>
        <ul class="recent">
          {recent.map((b) => (
            <li><span class="mono muted nr">{b.citation}</span><a href={url(`gesetze/${b.slug}/`)}>{b.headline}</a><span class="muted">{b.kind} · {b.stage_text}</span></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section id="labels" class="container labels">
    <h2>Wie sicher ist eine Zahl?</h2>
    <p class="muted">Neben jeder Zahl steht eines von vier Wörtern. Es sagt, woher die Zahl kommt.</p>
    <div class="label-grid">
      <div><div class="lw">gerechnet</div><p class="muted">Aus dem Gesetz berechnet. Jeder kann die Rechnung wiederholen.</p></div>
      <div><div class="lw">übernommen</div><p class="muted">Die Zahl stammt von der Regierung oder vom Budgetdienst des Parlaments.</p></div>
      <div><div class="lw">geschätzt</div><p class="muted">Unsere Rechnung mit einer Annahme. Deshalb steht eine Spanne da.</p></div>
      <div><div class="lw">nicht bezifferbar</div><p class="muted">Dazu gibt es keine belastbare Zahl. Wir sagen das, statt zu raten.</p></div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 64px 40px; }
  h1 { margin: 0; font-size: clamp(34px, 5vw, 56px); line-height: 1.05; font-weight: 800; letter-spacing: -0.025em; max-width: 820px; }
  .hero p { margin: 20px 0 0; font-size: 20px; max-width: 680px; }
  .cards { padding-bottom: 64px; }
  .band { background: var(--surface); border-block: 1px solid var(--line); }
  .band .container { padding-block: 56px; }
  .band-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; }
  h2 { margin: 0; font-size: 28px; font-weight: 800; letter-spacing: -0.015em; }
  .band-head a { font-weight: 600; }
  .band > .container > p { margin: 8px 0 28px; font-size: 16px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; }
  .tile { background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 18px; font-size: 15px; }
  .num { font-size: 36px; font-weight: 800; }
  h3 { margin: 36px 0 12px; font-size: 16px; font-weight: 700; }
  .recent { list-style: none; margin: 0; padding: 0; background: var(--bg); border: 1px solid var(--line); border-radius: 10px; }
  .recent li { display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 14px 18px; border-top: 1px solid var(--line); font-size: 16px; }
  .recent li:first-child { border-top: 0; }
  .recent .nr { width: 90px; font-size: 14px; }
  .recent a { flex: 1 1 320px; color: var(--ink); }
  .recent span:last-child { font-size: 14px; }
  .labels { padding-block: 56px 64px; }
  .labels > p { margin: 8px 0 28px; font-size: 17px; max-width: 680px; }
  .label-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .label-grid > div { border-top: 3px solid var(--ink); padding-top: 14px; }
  .lw { font-size: 18px; font-weight: 700; }
  .label-grid p { margin: 6px 0 0; font-size: 15px; }
</style>
