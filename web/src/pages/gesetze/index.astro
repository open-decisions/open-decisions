---
import Base from "../../layouts/Base.astro";
import Tracker from "../../components/islands/Tracker.svelte";
import { edition, url } from "../../lib/edition";
import { getBills, getCards, meta } from "../../lib/data";

const cards = await getCards();
const cardTitle = new Map(cards.map((c) => [c.id, c.title]));
const bills = (await getBills()).map((b) => ({
  id: b.id, slug: b.slug, citation: b.citation, title: b.title, headline: b.headline, type: b.type, kind: b.kind,
  stage: b.stage, step: b.step, stage_text: b.stage_text, areas: b.areas, happening: b.happening, next: b.next,
  introduced: b.introduced, eu: { group: b.eu.group, label: b.eu.label },
  href: url(`gesetze/${b.slug}/`),
  cards: b.measures.filter((m) => cardTitle.has(m)).map((m) => ({ title: cardTitle.get(m)!, href: url(`massnahmen/${m}/`) })),
}));
const stages = meta.stage_filters.map((s) => ({ ...s, count: meta.stage_counts[s.id as keyof typeof meta.stage_counts] }));
const types = meta.type_filters.map((t) => ({ ...t, count: meta.type_counts[t.id as keyof typeof meta.type_counts] }));
const eus = meta.eu_filters.map((e) => ({ ...e, count: meta.eu_counts[e.id as keyof typeof meta.eu_counts] }));
---
<Base title="Gesetze" current="bills" description={`Was im ${edition.chambers.first} gerade passiert und alle ${meta.bill_count} Gesetzesvorhaben der ${edition.legislative_period}.`}>
  <div class="container page">
    <h1>Was im Parlament passiert</h1>
    <p class="muted intro">Welche Gesetze gerade beraten, beschlossen oder neu eingebracht werden. Stand {meta.data_as_of_text}.</p>

    <section aria-labelledby="h-liste" class="list-section">
      <h2 id="h-liste" class="visually-hidden">Gesetzesvorhaben</h2>
      <Tracker client:load bills={bills} stages={stages} types={types} eus={eus} areas={meta.area_filters} total={meta.bill_count} />
      <p class="muted note">Die Überschriften stammen aus der Parlamentskorrespondenz oder der Kurzinformation der Parlamentsdirektion. Wo es keine gibt, steht der offizielle Titel. Den Bezug zur EU lesen wir automatisch aus der Folgenabschätzung der Regierung; er ist noch nicht von Hand geprüft. Daten: {edition.data_source}, CC BY 4.0.</p>
    </section>

    <details class="process">
      <summary>So entsteht ein Bundesgesetz</summary>
      <ol>
        {edition.process.map((p, i) => (<li><div class="step-n muted">{i + 1}</div><div class="step-t">{p.title}</div><div class="muted step-x">{p.text}</div></li>))}
      </ol>
      <p class="muted note">{edition.process_note}</p>
    </details>
  </div>
</Base>

<style>
  .page { padding-block: 40px 72px; }
  h1 { margin: 0; font-size: clamp(30px, 4.4vw, 48px); line-height: 1.08; font-weight: 800; letter-spacing: -0.025em; }
  .intro { margin: 12px 0 28px; font-size: 18px; max-width: 720px; }
  .note { margin: 14px 0 0; font-size: 14px; max-width: 760px; }
  .process { margin-top: 40px; background: var(--surface); border-radius: 12px; padding: 18px 24px; }
  .process summary { cursor: pointer; font-size: 18px; font-weight: 700; min-height: 44px; display: flex; align-items: center; }
  .process ol { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; }
  .process li { background: var(--bg); border-radius: 10px; padding: 14px; }
  .step-n { font-size: 13px; font-weight: 700; }
  .step-t { font-weight: 700; margin: 2px 0 4px; }
  .step-x { font-size: 14px; line-height: 1.45; }
</style>
