{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/massnahme.schema.json",
  "title": "Data contract v0: jurisdictions, households, bills, measures",
  "description": "Four record kinds. A jurisdictions file registers the decision levels of one country (federal, states, later municipalities). A households file defines the example households of one country. A bill is one item of a parliament's legislative process, keyed by jurisdiction plus the parliament's own key. A measure is one provision inside a bill that changes household finances directly; it gets the card. Field names and enum values are English; content is written in the language of the jurisdiction (lang). Every number carries a confidence label, every statement a source reference. External identifiers (ELI for laws, EuroVoc for topics, Wikidata for parties) link records to the outside world.",
  "oneOf": [
    {
      "$ref": "#/$defs/jurisdictions"
    },
    {
      "$ref": "#/$defs/households"
    },
    {
      "$ref": "#/$defs/bill"
    },
    {
      "$ref": "#/$defs/measure"
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$",
      "description": "ISO 3166-1 alpha-2 for the national level (AT), ISO 3166-2 for a state (AT-9 is Wien). Must be registered in data/jurisdictions/<country>.yaml."
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "BCP 47 tag of the content language, e.g. de-AT"
    },
    "bill_id": {
      "type": "string",
      "description": "Jurisdiction plus the parliament's own key. Federal Austria: AT/<GP>/<ITYP>/<INR>, e.g. AT/XXVIII/I/69. A state: AT-9/<key of the Landtag>.",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?/[A-Za-z0-9/-]+$"
    },
    "measure_id": {
      "type": "string",
      "description": "Lower-case jurisdiction, year of decision, short name; equals the file name without extension, e.g. at-2025-klimabonus or at-9-2026-wohnbeihilfe",
      "pattern": "^[a-z]{2}(-[a-z0-9]{1,3})?-\\d{4}-[a-z0-9-]+$"
    },
    "household_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}-H[1-9]$",
      "description": "Defined in data/households/<country>.yaml. Households are national archetypes; state-specific effects use the household's region field."
    },
    "confidence": {
      "type": "string",
      "description": "calculated: microsimulation from legal parameters, reproducible in the repo. adopted: taken from an official source, not recalculated. estimated: own calculation with at least one material assumption, range required. not_quantifiable: no defensible number, reason required.",
      "enum": [
        "calculated",
        "adopted",
        "estimated",
        "not_quantifiable"
      ]
    },
    "source_role": {
      "type": "string",
      "description": "Country-independent role of a source. Each jurisdiction maps its institutions to roles in its methodology appendix. Precedence on conflict: law_text > impact_assessment > parliamentary_budget_office > statistics > study > government_communication; government_communication may only back the 'said' element.",
      "enum": [
        "law_text",
        "impact_assessment",
        "parliamentary_budget_office",
        "statistics",
        "study",
        "government_communication"
      ]
    },
    "source_ref": {
      "type": "object",
      "description": "Reference to an entry in sources, with the exact location",
      "required": [
        "source",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "id from sources"
        },
        "ref": {
          "type": "string",
          "description": "Page, section, article or field, e.g. 'p. 46', '§ 2 (2)', 'Art. 71'"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "role",
        "title",
        "url",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "role": {
          "$ref": "#/$defs/source_role"
        },
        "institution": {
          "type": "string",
          "description": "The concrete body, e.g. 'Budgetdienst des Parlaments'"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "retrieved": {
          "$ref": "#/$defs/date"
        },
        "archive": {
          "type": [
            "string",
            "null"
          ],
          "description": "Web archive link or path of the local copy in the repo"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "amount": {
      "type": "object",
      "description": "A number with label and source. estimated requires low, high and assumptions. not_quantifiable requires reason and a null value. adopted, calculated and estimated require sources.",
      "required": [
        "value",
        "unit",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "eur_per_year",
            "eur_per_month",
            "eur_once",
            "mio_eur_per_year",
            "bn_eur_per_year",
            "bn_eur_total",
            "percent_of_income",
            "persons",
            "households"
          ]
        },
        "label": {
          "$ref": "#/$defs/confidence"
        },
        "year": {
          "type": "integer"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ids from assumptions"
        },
        "reason": {
          "type": "string",
          "description": "Required for not_quantifiable: one sentence"
        },
        "calculation": {
          "type": "string",
          "description": "One-line calculation or path to the input file in the repo"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "estimated"
              }
            }
          },
          "then": {
            "required": [
              "low",
              "high",
              "assumptions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "not_quantifiable"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "adopted",
                  "calculated",
                  "estimated"
                ]
              }
            }
          },
          "then": {
            "required": [
              "sources"
            ]
          }
        }
      ]
    },
    "party_vote": {
      "type": "object",
      "required": [
        "party",
        "seats",
        "in_favor"
      ],
      "additionalProperties": false,
      "properties": {
        "party": {
          "type": "string"
        },
        "seats": {
          "type": "integer",
          "minimum": 0
        },
        "in_favor": {
          "type": "boolean"
        },
        "wikidata": {
          "$ref": "#/$defs/wikidata"
        }
      }
    },
    "bill": {
      "type": "object",
      "title": "Bill",
      "required": [
        "kind",
        "jurisdiction",
        "lang",
        "id",
        "type",
        "title",
        "introduced",
        "status",
        "phases",
        "documents",
        "sources",
        "measures",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bill"
        },
        "jurisdiction": {
          "$ref": "#/$defs/jurisdiction"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "id": {
          "$ref": "#/$defs/bill_id"
        },
        "type": {
          "type": "string",
          "enum": [
            "government_bill",
            "members_bill"
          ],
          "description": "government_bill: introduced by the government (AT: Regierungsvorlage). members_bill: introduced by members of parliament (AT: Initiativantrag). Both are eligible."
        },
        "title": {
          "type": "string"
        },
        "citation": {
          "type": "string",
          "description": "The parliament's citation, e.g. '69 d.B.'"
        },
        "parliament_url": {
          "$ref": "#/$defs/url"
        },
        "introduced": {
          "$ref": "#/$defs/date"
        },
        "introduced_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "object",
          "required": [
            "stage"
          ],
          "additionalProperties": false,
          "properties": {
            "stage": {
              "type": "string",
              "enum": [
                "pre_parliamentary",
                "introduced",
                "committee",
                "passed_first_chamber",
                "passed_second_chamber",
                "published"
              ]
            },
            "source_status": {
              "type": "string",
              "description": "The parliament's own status code, verbatim"
            },
            "gazette": {
              "type": [
                "string",
                "null"
              ],
              "description": "Official gazette citation, e.g. 'BGBl. I Nr. 25/2025'"
            },
            "gazette_url": {
              "$ref": "#/$defs/url"
            }
          }
        },
        "pre_parliamentary": {
          "type": "array",
          "description": "Drafts before introduction, e.g. consultation drafts. Empty for members' bills.",
          "items": {
            "type": "object",
            "required": [
              "citation",
              "title",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "citation": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "$ref": "#/$defs/url"
              }
            }
          }
        },
        "phases": {
          "type": "array",
          "description": "Stations for the law tracker, chronological. chamber names the body in local terms.",
          "items": {
            "type": "object",
            "required": [
              "phase",
              "date",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "pre_parliamentary",
                  "introduced",
                  "committee",
                  "plenary",
                  "second_chamber_introduced",
                  "second_chamber_committee",
                  "second_chamber_plenary",
                  "published"
                ]
              },
              "chamber": {
                "type": "string"
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "text": {
                "type": "string"
              },
              "url": {
                "$ref": "#/$defs/url"
              }
            }
          }
        },
        "vote": {
          "type": [
            "object",
            "null"
          ],
          "description": "Final vote in the first chamber, per party",
          "required": [
            "date",
            "result"
          ],
          "additionalProperties": false,
          "properties": {
            "date": {
              "$ref": "#/$defs/date"
            },
            "session": {
              "type": "string"
            },
            "result": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/party_vote"
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "law_text_html": {
              "$ref": "#/$defs/url"
            },
            "law_text_pdf": {
              "$ref": "#/$defs/url"
            },
            "explanations_pdf": {
              "$ref": "#/$defs/url"
            },
            "comparison_pdf": {
              "$ref": "#/$defs/url"
            },
            "impact_assessment_pdf": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/url"
              },
              "description": "AT: Vorblatt und WFA. Empty for members' bills."
            }
          }
        },
        "budget_office_analyses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "date",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "url": {
                "$ref": "#/$defs/url"
              },
              "pdf_url": {
                "$ref": "#/$defs/url"
              }
            }
          }
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measure_id"
          },
          "description": "Measures that get a card. Other provisions of the bill are not recorded."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "retrieved": {
          "$ref": "#/$defs/date"
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "description": "External identifiers and classifications, taken from the parliament and the gazette",
          "properties": {
            "eli": {
              "$ref": "#/$defs/eli",
              "description": "ELI of the published act"
            },
            "eurovoc": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "EuroVoc descriptors as the parliament lists them"
            },
            "topics": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The parliament's own topic classification"
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The parliament's own keywords"
            }
          }
        },
        "eu_relation": {
          "type": "object",
          "required": [
            "kind",
            "method",
            "checked"
          ],
          "additionalProperties": false,
          "description": "How the bill relates to EU law. Derived from the impact assessment's section on EU law and from transposition wording in the documents; unchecked until a human confirms it.",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "transposes_directive",
                "implements_regulation",
                "eu_scope",
                "national",
                "not_stated"
              ],
              "description": "transposes_directive: implements an EU directive; implements_regulation: accompanying rules for directly applicable EU regulations; eu_scope: within EU law but not required by it; national: outside EU law; not_stated: no statement found"
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "All kinds found across parts of the bill, highest priority first"
            },
            "goes_beyond": {
              "type": "boolean",
              "description": "The impact assessment states that the bill goes beyond what EU law requires"
            },
            "statements": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "text",
                  "kind",
                  "source"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "source": {
                    "$ref": "#/$defs/url"
                  },
                  "page": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            },
            "acts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/eu_act"
              }
            },
            "method": {
              "type": "string",
              "enum": [
                "text_extraction",
                "manual"
              ]
            },
            "checked": {
              "type": "boolean"
            }
          }
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Kurzinformation of the parliament administration, one item per bullet point"
        },
        "press": {
          "type": "array",
          "description": "Releases of the parliament's press service (Parlamentskorrespondenz) about this bill, oldest first",
          "items": {
            "type": "object",
            "required": [
              "title",
              "date",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "url": {
                "$ref": "#/$defs/url"
              },
              "heading": {
                "type": "string",
                "description": "Heading of the section about this bill inside the release, when the release covers several items"
              }
            }
          }
        }
      }
    },
    "measure": {
      "type": "object",
      "title": "Measure",
      "required": [
        "kind",
        "jurisdiction",
        "lang",
        "id",
        "bill",
        "article",
        "title",
        "status",
        "selection",
        "said",
        "law_change",
        "affected",
        "timing",
        "effects",
        "unclear",
        "assumptions",
        "sources",
        "follow_up",
        "review",
        "changelog"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "measure"
        },
        "jurisdiction": {
          "$ref": "#/$defs/jurisdiction"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "id": {
          "$ref": "#/$defs/measure_id"
        },
        "bill": {
          "$ref": "#/$defs/bill_id"
        },
        "article": {
          "type": "string",
          "description": "Article or part of the bill, e.g. 'Art. 71'"
        },
        "law": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "abbreviation": {
              "type": "string"
            },
            "original_gazette": {
              "type": "string"
            },
            "consolidated_url": {
              "$ref": "#/$defs/url"
            },
            "eli": {
              "$ref": "#/$defs/eli",
              "description": "ELI of the act being amended, as originally published"
            }
          }
        },
        "title": {
          "type": "string",
          "description": "Card element 1: plain language, max. 8 words"
        },
        "status": {
          "type": "object",
          "required": [
            "state",
            "since"
          ],
          "additionalProperties": false,
          "description": "Card element 2",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "announced",
                "introduced",
                "passed",
                "in_force"
              ]
            },
            "since": {
              "$ref": "#/$defs/date"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_ref"
              }
            }
          }
        },
        "selection": {
          "type": "object",
          "required": [
            "status_ok",
            "household_relevance",
            "evidence_ok",
            "rationale",
            "decided_on"
          ],
          "additionalProperties": false,
          "description": "All three selection criteria plus one sentence",
          "properties": {
            "status_ok": {
              "type": "boolean"
            },
            "household_relevance": {
              "type": "string",
              "enum": [
                "taxes",
                "transfers",
                "pensions",
                "fees",
                "minimum_wage",
                "indexation",
                "other"
              ]
            },
            "evidence_ok": {
              "type": "boolean"
            },
            "rationale": {
              "type": "string"
            },
            "decided_on": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "said": {
          "type": "object",
          "required": [
            "quote",
            "speaker",
            "role",
            "date",
            "sources"
          ],
          "additionalProperties": false,
          "description": "Card element 3: verbatim quote of the official message. The only place where persons and parties are named.",
          "properties": {
            "quote": {
              "type": "string"
            },
            "speaker": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "date": {
              "$ref": "#/$defs/date"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source_ref"
              }
            }
          }
        },
        "law_change": {
          "type": "object",
          "required": [
            "summary",
            "parameters"
          ],
          "additionalProperties": false,
          "description": "Card element 4",
          "properties": {
            "summary": {
              "type": "string",
              "description": "2 to 3 sentences, no jargon, no judgement"
            },
            "parameters": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "old",
                  "new",
                  "applies_from",
                  "sources"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "old": {
                    "type": [
                      "number",
                      "string",
                      "null"
                    ]
                  },
                  "new": {
                    "type": [
                      "number",
                      "string",
                      "null"
                    ]
                  },
                  "unit": {
                    "type": "string"
                  },
                  "applies_from": {
                    "type": "string",
                    "description": "Date or calendar year"
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/source_ref"
                    }
                  }
                }
              }
            }
          }
        },
        "affected": {
          "type": "object",
          "required": [
            "who",
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "who": {
              "type": "string"
            },
            "condition": {
              "type": "string"
            },
            "count": {
              "$ref": "#/$defs/amount"
            }
          }
        },
        "timing": {
          "type": "object",
          "required": [
            "effective_from",
            "first_full_year",
            "fifth_year",
            "indexation"
          ],
          "additionalProperties": false,
          "properties": {
            "effective_from": {
              "$ref": "#/$defs/date"
            },
            "first_full_year": {
              "type": "integer"
            },
            "fifth_year": {
              "type": "integer"
            },
            "limited_until": {
              "type": [
                "string",
                "null"
              ]
            },
            "transition": {
              "type": [
                "string",
                "null"
              ]
            },
            "indexation": {
              "type": "string",
              "enum": [
                "none",
                "statutory",
                "discretionary",
                "not_applicable"
              ],
              "description": "Is the new value adjusted for inflation?"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "effects": {
          "type": "object",
          "required": [
            "households",
            "aggregate"
          ],
          "additionalProperties": false,
          "description": "Card element 5. Every example household of the jurisdiction has an entry, including 'no change'.",
          "properties": {
            "households": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "household",
                  "short_term",
                  "long_term"
                ],
                "additionalProperties": false,
                "properties": {
                  "household": {
                    "$ref": "#/$defs/household_id"
                  },
                  "short_term": {
                    "$ref": "#/$defs/amount"
                  },
                  "long_term": {
                    "$ref": "#/$defs/amount"
                  },
                  "share_of_income": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Share of disposable yearly income, required above 500 EUR"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "aggregate": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "description",
                  "amount"
                ],
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "amount": {
                    "$ref": "#/$defs/amount"
                  }
                }
              }
            },
            "distribution": {
              "type": "object",
              "additionalProperties": false,
              "description": "Decile statements, usually adopted from the parliamentary budget office",
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "$ref": "#/$defs/confidence"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/source_ref"
                  }
                }
              }
            }
          }
        },
        "unclear": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Card element 6: 1 to 3 items, never empty"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "what",
              "why",
              "alternative"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^A\\d+$"
              },
              "what": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "alternative": {
                "type": "string",
                "description": "What would change under a different reading"
              }
            }
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "follow_up": {
          "type": "object",
          "required": [
            "date",
            "what"
          ],
          "additionalProperties": false,
          "properties": {
            "date": {
              "$ref": "#/$defs/date"
            },
            "what": {
              "type": "string"
            },
            "sources_to_check": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "required": [
            "created",
            "approved",
            "checklist"
          ],
          "additionalProperties": false,
          "description": "Release checklist. Approval no earlier than 24 h after creation.",
          "properties": {
            "created": {
              "$ref": "#/$defs/date"
            },
            "approved": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "approved_by": {
              "type": "string"
            },
            "checklist": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parameters_checked",
                "assumptions_documented",
                "reproducible",
                "labels_correct",
                "style_checked",
                "quote_sourced",
                "unclear_filled"
              ],
              "properties": {
                "parameters_checked": {
                  "type": "boolean"
                },
                "assumptions_documented": {
                  "type": "boolean"
                },
                "reproducible": {
                  "type": "boolean"
                },
                "labels_correct": {
                  "type": "boolean"
                },
                "style_checked": {
                  "type": "boolean"
                },
                "quote_sourced": {
                  "type": "boolean"
                },
                "unclear_filled": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "changelog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "change",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "change": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "households": {
      "type": "object",
      "title": "Example households of one country",
      "required": [
        "kind",
        "jurisdiction",
        "lang",
        "version",
        "households"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "households"
        },
        "jurisdiction": {
          "$ref": "#/$defs/country"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "version": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "households": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "adults",
              "children",
              "gross_income_month",
              "housing",
              "region"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/household_id"
              },
              "label": {
                "type": "string",
                "description": "Short description shown on the card"
              },
              "adults": {
                "type": "integer",
                "minimum": 1
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "Ages of children"
              },
              "employment": {
                "type": "string"
              },
              "gross_income_month": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "One entry per adult, EUR per month; 0 for no earned income"
              },
              "other_income": {
                "type": "string"
              },
              "housing": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "disposable_income_year": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Filled once calculated; used for share_of_income"
              },
              "input_file": {
                "type": "string",
                "description": "Path of the microsimulation input file in the repo"
              },
              "adult_ages": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "Ages of the adults, when a measure depends on age"
              },
              "commute": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "one_way_km",
                  "mode"
                ],
                "description": "Commute of the first adult; needed for commuter measures",
                "properties": {
                  "one_way_km": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "car",
                      "public",
                      "none"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              "short_label": {
                "type": "string",
                "description": "Short name for buttons and lists, max. about 30 characters"
              }
            }
          }
        }
      }
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2"
    },
    "eli": {
      "type": "string",
      "pattern": "^https?://.+/eli/.+",
      "description": "European Legislation Identifier as URL, e.g. https://www.ris.bka.gv.at/eli/bgbl/I/2025/25"
    },
    "wikidata": {
      "type": "string",
      "pattern": "^Q\\d+$",
      "description": "Wikidata item id, e.g. Q186867"
    },
    "jurisdictions": {
      "type": "object",
      "title": "Decision levels of one country",
      "required": [
        "kind",
        "country",
        "lang",
        "entries"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "jurisdictions"
        },
        "country": {
          "$ref": "#/$defs/country"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "note": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "name",
              "level",
              "parliament",
              "law_source",
              "gazette",
              "active"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "$ref": "#/$defs/jurisdiction"
              },
              "name": {
                "type": "string"
              },
              "level": {
                "type": "string",
                "enum": [
                  "federal",
                  "state",
                  "municipal"
                ]
              },
              "active": {
                "type": "boolean",
                "description": "false while the methodology excludes this level; records may exist but are not published"
              },
              "parliament": {
                "type": "object",
                "required": [
                  "name",
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "$ref": "#/$defs/url"
                  },
                  "api": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Machine-readable access, null if none is known"
                  },
                  "adapter": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Name of the ingest adapter package, null until written"
                  }
                }
              },
              "law_source": {
                "type": "object",
                "required": [
                  "name",
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "$ref": "#/$defs/url"
                  },
                  "api": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "gazette": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "eli_prefix": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "impact_assessment": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which impact assessment exists at this level, if any"
              },
              "budget_office": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Independent budget analysis body at this level, if any"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "eu_act": {
      "type": "object",
      "required": [
        "celex",
        "type",
        "label",
        "role",
        "eurlex_url"
      ],
      "additionalProperties": false,
      "properties": {
        "celex": {
          "type": "string",
          "pattern": "^3\\d{4}[LRD]\\d{4}$",
          "description": "CELEX number of the EU act"
        },
        "type": {
          "type": "string",
          "enum": [
            "directive",
            "regulation",
            "decision"
          ]
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "transposed",
            "implemented"
          ],
          "description": "transposed: the bill transposes this directive; implemented: the bill contains accompanying rules for this regulation"
        },
        "eurlex_url": {
          "$ref": "#/$defs/url"
        },
        "eli": {
          "type": "string"
        }
      }
    }
  }
}
